{
  "fixture_version": 1,
  "purpose": "Neutral cross-language vectors for the strict Ed25519 definition of RFC 0006 section 3, which section 2 applies to transaction signatures and receipt signatures (rule (h)). Each case gives the exact signed message, the public key, the signature, and the verdict the definition requires.",
  "authority": {
    "definition": "docs/rfcs/0006-chain-identity-authenticated-blocks.md, section 3: s is below the group order, R and the public key are canonical and not of small order, and the equation is checked without the cofactor (RFC 8032)",
    "applies_to": "section 2: transaction signatures and receipt signatures (rule (h)). Block signatures follow in S1-7.",
    "transaction_message": "the transaction signing payload, as in test-vectors/transaction/nonce-boundary-v1.json signing_formula",
    "receipt_message": "the raw 32-byte receipt hash, as in test-vectors/receipt/receipt-v1.json"
  },
  "conventions": {
    "hex": "lowercase, no 0x prefix",
    "expected": "valid or invalid under the strict definition, nothing else",
    "rule": "the first requirement of the definition that the case does not meet, or valid",
    "keys": "every seed used is TEST ONLY and public: the receipt fixture's test_key (0x2a repeated) and 0x5b repeated"
  },
  "derivation": {
    "method": "Derived with an Ed25519 implementation written independently of ed25519-dalek and @noble (BigInt arithmetic from RFC 8032, SHA-512 from node:crypto) and a BLAKE3 written from its specification. The implementation was first checked against RFC 8032 tests 1 to 3, against OpenSSL on random keys and messages, and against the eight small-order encodings published in libsodium's blocklist. Every expected verdict was then computed by that implementation's reading of the strict definition."
  },
  "rules": [
    "valid",
    "s-not-below-group-order",
    "key-small-order",
    "key-non-canonical",
    "key-not-a-point",
    "r-small-order",
    "r-non-canonical",
    "r-not-a-point",
    "cofactored-equation-only",
    "wrong-message"
  ],
