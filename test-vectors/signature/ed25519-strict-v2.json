{
  "fixture_version": 2,
  "purpose": "Neutral cross-language vectors for the strict Ed25519 definition of RFC 0006 section 3, which section 2 applies to transaction signatures and receipt signatures (rule (h)). Each case gives the exact signed message, the public key, the signature, and the verdict the definition requires. Version 2 (RFC 0006 section 2, S1-5): each transaction message is \"mbongo-tx:v2\" || chain_id || the transaction fields, for the dev chain below, and its signatures were derived again over it; the receipt cases are those of version 1.",
  "supersedes": "test-vectors/signature/ed25519-strict-v1.json",
  "chain": {
    "chain_id": "2fd700acc09b3d1752ca6fe21e7d6f4844917c5a9fcd41a34fe1d13d7deed1a4",
    "chain_id_source": "crates/mbongo-core/genesis/dev.json, the dev genesis: chain_id = BLAKE3(\"mbongo:chain-id:v1\" || file_bytes)",
    "signing_domain": {
      "ascii": "mbongo-tx:v2",
      "hex": "6d626f6e676f2d74783a7632",
      "length": 12
    }
  },
  "authority": {
    "definition": "docs/rfcs/0006-chain-identity-authenticated-blocks.md, section 3: s is below the group order, R and the public key are canonical and not of small order, and the equation is checked without the cofactor (RFC 8032)",
    "applies_to": "section 2: transaction signatures and receipt signatures (rule (h)). Block signatures follow in S1-7.",
    "transaction_message": "the transaction signing payload \"mbongo-tx:v2\" || chain_id || transaction_fields, as in test-vectors/transaction/nonce-boundary-v2.json signing_formula",
    "receipt_message": "the raw 32-byte receipt hash, as in test-vectors/receipt/receipt-v1.json"
  },
  "conventions": {
    "hex": "lowercase, no 0x prefix",
    "expected": "valid or invalid under the strict definition, nothing else",
    "rule": "the first requirement of the definition that the case does not meet, or valid",
    "keys": "every seed used is TEST ONLY and public: the receipt fixture's test_key (0x2a repeated) and 0x5b repeated"
  },
  "derivation": {
    "method": "Derived with an Ed25519 implementation written independently of ed25519-dalek and @noble (BigInt arithmetic from RFC 8032, SHA-512 from node:crypto) and a BLAKE3 written from its specification. The implementation was first checked against RFC 8032 tests 1 to 3, against OpenSSL on random keys and messages, and against the eight small-order encodings published in libsodium's blocklist. Every expected verdict was then computed by that implementation's reading of the strict definition.",
    "version_2": "The S1-2 derivation of version 1, run with the version 2 transaction message. Every transaction case, including the crafted small-order and cofactored-only signatures, was built again over that message, and every verdict computed again."
  },
  "rules": [
    "valid",
    "s-not-below-group-order",
    "key-small-order",
    "key-non-canonical",
    "key-not-a-point",
    "r-small-order",
    "r-non-canonical",
    "r-not-a-point",
    "cofactored-equation-only",
    "wrong-message"
  ],
