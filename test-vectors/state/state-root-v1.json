  "purpose": "Cross-language vectors for the state commitment of RFC 0006 §4 and rule (w) of §5: state_root(0) from the genesis chain_id and allocations, and state_root(h) from the parent's root and what block h changes, including skipped transactions and the candidates a producer leaves out (§3).",
  "authority": {
    "rfc": "docs/rfcs/0006-chain-identity-authenticated-blocks.md §3 (production order), §4 (state commitment), §5 rule (w), §6 (state transition)",
    "plan": "docs/architecture/S1_IMPLEMENTATION_PLAN.md S1-6",
    "implementation": "crates/mbongo-core/src/state.rs; crates/mbongo-node/src/backend.rs (BlockView, apply_block, produce_block)"
  },
  "conventions": {
    "hex": "lowercase, no 0x prefix",
    "integers": "fixed-width little-endian; collection and byte-vector lengths are SCALE compact",
    "account_value": "SCALE(Account) = address (32) || balance (u128, 16) || nonce (u64, 8)",
    "changes": "Vec<(u8 kind, [u8; 32] key, Vec<u8> value)>, sorted by kind, then by key bytewise; one entry per key, holding the value after the whole block",
    "kinds": {
      "0": "account: key the address, value SCALE(Account)",
      "1": "task: key the task_id, value SCALE(ComputeTask)",
      "2": "receipt: key the task_id, value SCALE(Receipt)"
    },
    "transactions": "described by type, sender, receiver, amount and nonce, by test key name; each is signed for this file's chain_id with the sender's seed. ComputeTask and AnchorReceipt have amount 0 and the zero receiver, and carry the named task or the receipt below. A {repeat_of} entry is the byte-identical transaction of that earlier block."
  },
  "derivation": {
    "method": "Derived by a script independent of the Rust crates and of the SDK: BLAKE3 written from the specification, Ed25519 public keys from OpenSSL, SCALE written by hand, and which entries a block has from a model of RFC 0006 §6 and §4 written from the RFC text. Task and receipt bytes are inputs from the fixtures below, checked against each other.",
    "inputs": [
      "test-vectors/compute-task/compute-task-v1.json: tasks canonical and empty-spec, and the executor test key",
      "test-vectors/receipt/receipt-v1.json: the submitter test key",
      "test-vectors/compute-task/anchor-binding-v2.json: vector bound-named-executor, the receipt of the canonical task"
    ]
  },
