{
  "fixture_version": 1,
  "purpose": "Neutral public-wire fixture for rpc_v0.3: the JSON objects a node returns from get_block_by_height and accepts in submit_transaction once TransactionPayload::ComputeTask exists. Pins the minimal, canonical and maximal ComputeTask transaction objects, a block carrying all three payload variants, the observed behaviour of the published rpc_v0.2 SDK, and the unknown-variant rule.",
  "authority": {
    "rpc_contract": "docs/specs/rpc_v0.3.md §1 (byte encoding), §4.1 (payload union), §4.4 (ComputeTask object)",
    "frozen_predecessor": "docs/specs/rpc_v0.2.md — unchanged; its §4.1 payload union is what v0.3 widens",
    "protocol_bytes": "test-vectors/compute-task/compute-task-v1.json and anchor-binding-v1.json — every task identity, signature and hash resolves there or is derived with the same method; test-vectors/receipt/receipt-v1.json supplies the submitter test key",
    "consensus": "docs/rfcs/0005-compute-task-commitment-v1.md — RPC represents the object and validates nothing; rules (k)–(s) live in the node"
  },
  "conventions": {
    "json_byte_encoding": "Address and Hash → \"0x\" + 64 lowercase hex; signature → \"0x\" + 128 hex; plain [u8; N] / Vec<u8> (salt, input_commitment, execution_spec, and the receipt's task_id, input_commitment, output_commitment, metadata) → array of numbers 0..=255; u128 / u64 / u8 → JSON number",
    "payload_tagging": "externally tagged: \"None\" is the bare string; the other variants are single-key objects {\"AnchorReceipt\": {…}} and {\"ComputeTask\": {…}}",
    "hex_in_expected": "lowercase, no 0x prefix, as in the protocol fixtures",
    "task_id": "not a wire field of the transaction: derived by the client per RFC 0005 §2.2 (BLAKE3(DOMAIN_TASK || SCALE(task))) and carried on the wire only inside a receipt's task_id array"
  },
  "derivation": {
    "method": "Objects assembled by hand from the serde annotations; the transfer and the minimal task were signed here with an independent Ed25519 over hand-laid SCALE; the canonical and maximal tasks were re-derived and checked byte-for-byte against compute-task-v1.json; the anchor object is the bound-named-executor vector of anchor-binding-v1.json rendered to JSON; transactions_root is an independent BLAKE3 over length-prefixed SCALE transactions.",
    "machine_inputs": "the three protocol fixtures named under authority"
  },
  "test_key": {
    "warning": "TEST ONLY. NOT A PRODUCTION KEY.",
    "source": "resolved from test-vectors/receipt/receipt-v1.json test_key"
  },
