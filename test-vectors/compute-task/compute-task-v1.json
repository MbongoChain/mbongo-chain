{
  "fixture_version": 1,
  "purpose": "Neutral cross-language golden vectors for RFC 0005 ComputeTask envelopes and the transactions that carry them. Pins the canonical SCALE task bytes, the task_id preimage and derivation, the transaction signing bytes, the transaction signature, the full encoding, the transaction hash, and the serialised Transaction JSON object.",
  "authority": {
    "envelope_and_identity": "docs/rfcs/0005-compute-task-commitment-v1.md §2.1, §2.2, §2.7, §2.10 (Accepted)",
    "transaction_structure": "crates/mbongo-core/src/primitives.rs — Transaction, TransactionType, TransactionPayload, Transaction::signing_payload",
    "envelope_type": "crates/mbongo-core/src/compute_task.rs — ComputeTask, DOMAIN_TASK, ComputeTask::task_id",
    "transaction_hash": "crates/mbongo-node/src/backend.rs — compute_tx_hash",
    "consensus_rules": "RFC 0005 §3 rules (k)–(p); precedence to be pinned in PROTOCOL_LOCK_v0.4",
    "receipt_key": "test-vectors/receipt/receipt-v1.json — the submitter test key is resolved there and never restated"
  },
  "conventions": {
    "hex": "lowercase, no 0x prefix, except inside serialized_transaction which reproduces the JSON wire form",
    "byte_order": "fixed-width integers are little-endian and never compact",
    "execution_spec_encoding": "SCALE compact length prefix, then the raw bytes",
    "execution_spec_pattern": "{pattern:repeat, byte:<hex>, length:<n>} expands to that byte repeated length times; {pattern:literal, hex:<hex>} is the exact bytes",
    "task_reference": "task_vector names a vector in this file's `tasks` array; resolve it there",
    "sender": "<task.submitter> means: resolve the referenced task vector and use its submitter, which consensus requires (rule o)"
  },
  "derivation": {
    "method": "Every expected value was constructed from the protocol rules, not by encoding with production Rust or the TypeScript SDK. SCALE laid out by hand as concatenated fields; the compact prefix and the fixed-width little-endian integers by explicit construction; the domain tag as literal bytes; signatures by an independent Ed25519; hashes by an independent BLAKE3. Rust and TypeScript are consumers that must agree with values neither produced.",
    "upstream_truth": "test-vectors/receipt/receipt-v1.json supplies the submitter test key; nothing else is a machine input."
  },
  "envelope": {
    "canonical_field_order": [
      "version",
      "submitter",
      "executor",
      "salt",
      "input_commitment",
      "execution_spec"
    ],
    "encoding": "version[1] || submitter[32] || executor[32] || salt[32] || input_commitment[32] || compact(len(execution_spec)) || execution_spec",
    "task_id": "BLAKE3(DOMAIN_TASK || canonical task bytes)",
    "task_id_is_not_a_field": true,
    "version": 1
  },
  "domain_task": {
    "ascii": "mbongo:compute-task:v1",
    "hex": "6d626f6e676f3a636f6d707574652d7461736b3a7631",
    "length": 22,
    "note": "Prepended raw. No NUL terminator, no SCALE length prefix, no hex rendering. The wrong_tag_diagnostics block pins what each of those mistakes would produce."
  },
  "execution_spec_max_bytes": 1024,
  "maximal_sizes": {
    "canonical_task": 1155,
    "task_id_preimage": 1177
  },
  "signing_formula": {
    "transaction_signing_payload": "0x01 || sender[32] || receiver[32] || amount_u128_le[16] || nonce_u64_le[8] || 0x02 || <canonical task bytes>",
    "fixed_bytes_before_task": 90,
    "full_transaction": "signing payload || transaction_signature[64]",
    "transaction_hash": "BLAKE3(full transaction), so it covers the signature",
    "prehash": "none — the transaction signature is over the raw signing payload bytes",
    "envelope_signature": "none — RFC 0005 §2.5: the transaction signature is the only authentication; the envelope carries no second signature"
  },
  "discriminants": {
    "TransactionType::ComputeTask": "01",
    "TransactionPayload::ComputeTask": "02",
    "note": "Both come from explicit #[codec(index = ...)] attributes. TransactionType::ComputeTask keeps the index frozen at v0.3; TransactionPayload::ComputeTask is the new index 2, appended after None (0) and AnchorReceipt (1), which are unchanged."
  },
  "commitment_invariants": {
    "sender": "must equal task.submitter (rule o)",
    "receiver": "must be the zero address, 32 zero bytes, with no Option marker and no length prefix (rule l)",
    "amount": "must be 0 (rule l)",
    "version": "task.version must be 1 (rule m)",
    "execution_spec": "at most 1024 bytes (rule n)"
  },
