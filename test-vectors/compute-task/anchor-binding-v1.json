  "fixture_version": 1,
  "purpose": "Neutral cross-language vectors for RFC 0005 rules (q)–(s): the binding between an anchored receipt and the registered ComputeTask it answers. One vector per outcome, as RFC 0005 §12 requires: a bound receipt from the named executor; a receipt whose input_commitment does not match (rule r); a receipt from an executor the task did not name (rule s); and a receipt for a task that was never registered (rule q).",
  "authority": {
    "binding_rules": "docs/rfcs/0005-compute-task-commitment-v1.md §3 rules (q), (r), (s); §5.2; §9.1",
    "anchoring_rules": "docs/rfcs/0002-receipt-anchoring-v0.3.md §2 rules (a)–(j); PROTOCOL_LOCK_v0.3 (FROZEN)",
    "receipt_encoding": "test-vectors/receipt/receipt-v1.json — unchanged; no receipt field is added or changed by rules (q)–(s)",
    "anchor_transaction_encoding": "test-vectors/transaction/anchor-receipt-v1.json — unchanged",
    "tasks": "test-vectors/compute-task/compute-task-v1.json — every task_vector resolves there; task identities are never restated",
    "consensus": "crates/mbongo-node/src/backend.rs — check_receipt_binding, apply_block"
  },
  "conventions": {
    "hex": "lowercase, no 0x prefix",
    "byte_order": "fixed-width integers are little-endian and never compact",
    "task_reference": "task_vector names a vector in compute-task-v1.json `tasks`; null means the receipt's task_id is registered nowhere",
    "sender": "<receipt.executor> means: the anchoring transaction is signed by the receipt's executor, which rule (g) requires",
    "metadata_pattern": "{pattern:repeat, byte:<hex>, length:<n>} expands to that byte repeated length times"
  },
  "derivation": {
    "method": "Every expected value was constructed from the protocol rules, not by encoding with production Rust or the TypeScript SDK: receipt and transaction SCALE laid out by hand, hashes by an independent BLAKE3, signatures by an independent Ed25519. Rules (q)–(s) introduce no new encoding, so the only new pinned bytes are the hashes and signatures of these five receipts and their carrying transactions.",
    "machine_inputs": "test-vectors/receipt/receipt-v1.json (submitter test key) and test-vectors/compute-task/compute-task-v1.json (task identities, executor test key)."
  },
  "binding_rules": {
    "q": "a task with receipt.task_id exists in prior chain state or earlier in the same block",
    "r": "receipt.input_commitment == task.input_commitment",
    "s": "receipt.executor == task.executor",
    "order": "after RFC 0002 rules (a)–(j), in the order q, r, s",
    "what_is_not_checked": "how either commitment was derived; the input; the output; whether the answer is correct (RFC 0005 §2.4, §9.2)"
  },
