{
  "fixture_version": 1,
  "purpose": "Neutral cross-language vectors for the genesis file and chain identifier of RFC 0006 section 1: valid files with their chain_id and contents, and malformed files with the error class each must be refused with.",
  "authority": {
    "file": "docs/rfcs/0006-chain-identity-authenticated-blocks.md, section 1: canonical form, field rules, exactly one authority",
    "chain_id": "chain_id = BLAKE3(\"mbongo:chain-id:v1\" || file_bytes)",
    "dev_genesis": "name dev, timestamp 0, the existing dev account (seed 0xAA repeated) with 1000000000, and the authority whose seed is BLAKE3(\"mbongo:dev-authority:v1\")"
  },
  "conventions": {
    "file_hex": "the exact file bytes, lowercase hex. A file is its bytes: no newline is implied",
    "error": "the class of the first defect; each invalid case differs from a valid file by one defect",
    "keys": "every seed is TEST ONLY and public"
  },
  "derivation": {
    "method": "Files were written by hand from the field rules. chain_id comes from a BLAKE3 written from its specification, and public keys from an Ed25519 implementation written independently of ed25519-dalek and @noble. Both were checked first against published values; see test-vectors/signature/README.md and test-vectors/transaction/README.md."
  },
