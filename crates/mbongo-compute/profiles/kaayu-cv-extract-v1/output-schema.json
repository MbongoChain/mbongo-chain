{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaayu-cv-profile:v1",
  "title": "kaayu-cv-profile:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "seniority", "location", "skills", "experience", "education", "languages", "certifications"],
  "properties": {
    "summary": { "type": "string", "maxLength": 600 },
    "seniority": { "type": "string", "enum": ["unknown", "junior", "mid", "senior", "lead", "executive"] },
    "location": { "type": "string", "maxLength": 120 },
    "skills": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 60 } },
    "experience": {
      "type": "array", "maxItems": 15,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "organization", "start", "end", "description"],
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "organization": { "type": "string", "maxLength": 120 },
          "start": { "type": "string", "maxLength": 10 },
          "end": { "type": "string", "maxLength": 10 },
          "description": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "education": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["degree", "institution", "year"],
        "properties": {
          "degree": { "type": "string", "maxLength": 120 },
          "institution": { "type": "string", "maxLength": 120 },
          "year": { "type": "string", "maxLength": 10 }
        }
      }
    },
    "languages": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["language", "level"],
        "properties": {
          "language": { "type": "string", "maxLength": 40 },
          "level": { "type": "string", "enum": ["unknown", "basic", "intermediate", "fluent", "native"] }
        }
      }
    },
    "certifications": { "type": "array", "maxItems": 15, "items": { "type": "string", "maxLength": 100 } }
  }
}
