# Versioned, deterministic defaults for the Dockerised 3-node devnet (#53).
#
# Never put secrets here. A fresh checkout must boot the devnet with this
# file alone; .env.local (gitignored) and .env.ci layer on top of it.

# ── Image ───────────────────────────────────────────────────────────────
MBONGO_IMAGE=mbongo-devnet:local
RUST_VERSION=1.94.0

# ── Chain ───────────────────────────────────────────────────────────────
MBONGO_CHAIN=dev
# Fast blocks so a bootstrap converges in seconds rather than minutes.
MBONGO_BLOCK_TIME=1

# ── In-container ports ──────────────────────────────────────────────────
# Every node uses the same ports; isolation comes from the dedicated
# Compose network, not from juggling port numbers.
MBONGO_RPC_PORT=9944
MBONGO_REST_PORT=8080
MBONGO_P2P_PORT=30333

# ── Bind hosts (inside the container only) ──────────────────────────────
# 0.0.0.0 is required for cross-container reachability. This is a devnet
# choice scoped to the Compose network; it is NOT a production default.
# The node still defaults to 127.0.0.1 when these flags are not passed.
MBONGO_RPC_HOST=0.0.0.0
MBONGO_REST_HOST=0.0.0.0

# ── Network topology ────────────────────────────────────────────────────
# A dedicated subnet with a fixed producer address is what makes the
# bootstrap deterministic: followers get an explicit bootnode multiaddr and
# do not depend on any runtime discovery.
MBONGO_SUBNET=172.28.53.0/24
MBONGO_PRODUCER_IP=172.28.53.10

# ── Convergence probe bounds ────────────────────────────────────────────
MBONGO_MIN_HEIGHT=5
MBONGO_READY_TIMEOUT_SECS=120
MBONGO_CONVERGENCE_TIMEOUT_SECS=120
MBONGO_POLL_INTERVAL_MS=500

# ── Host exposure ───────────────────────────────────────────────────────
# Only the producer RPC is published, bound to loopback, for local
# debugging. 29944 deliberately avoids the operational devnet (9944-9946)
# and the in-process devnet_harness (19944-19946).
MBONGO_HOST_RPC_PORT=29944

# ── Logging ─────────────────────────────────────────────────────────────
RUST_LOG=info
