# Controlled MVP launch configuration (docs/product/MVP_LAUNCH_RUNBOOK.md).
#
# Copy to a location OUTSIDE the repository (for example
# %USERPROFILE%\mbongo-mvp\mvp-launch.env) and fill the placeholders.
# This file holds non-secret settings and the PATHS of key files only —
# never a key. Key files are 64 hex characters (a 32-byte seed), readable by
# the operator account only, stored outside the repository, never committed.
# Used by: node scripts/mvp-launch.mjs <verify|start|health|smoke|stop> --config <this file>

# ── network: every listener is loopback; remote access needs an external
#    trusted boundary (VPN or a TLS-terminating reverse proxy) ─────────────
MBONGO_MVP_BIND=127.0.0.1:8740
MBONGO_MVP_FRONT=http://127.0.0.1:8740
MBONGO_MVP_RPC_URL=http://127.0.0.1:39944/rpc
MBONGO_MVP_REST_URL=http://127.0.0.1:38080

# ── worker: CPU only (GPU offload is fixed at 0 in code), pinned runtime and
#    model resolved from ~/.cache/mbongo/inference; there is no model or
#    runtime option ──────────────────────────────────────────────────────────
MBONGO_INFER_THREADS=6

# ── secrets: paths only ──────────────────────────────────────────────────────
# Client (task submitter) key: signs ComputeTask transactions and every HTTP request.
MBONGO_MVP_KEY_FILE=<path to the client key seed file>
# Executor (worker) key: signs receipts; read by mvp_service only.
MBONGO_MVP_EXECUTOR_KEY_FILE=<path to the executor key seed file>
# Devnet funding key, used once by `start --fund` to create the executor account.
MBONGO_MVP_FUNDER_KEY_FILE=<path to the funder key seed file>
# The executor address clients name (public): `mvp_service executor-address`.
MBONGO_MVP_EXECUTOR=<executor address, 0x + 64 hex>

# ── operations ───────────────────────────────────────────────────────────────
# Logs, pids, smoke outputs. Outside the repository; contains synthetic or
# private results after a smoke — treat as private.
MBONGO_MVP_STATE_DIR=<directory outside the repository>
# Displayed reference cost only (MVP_v0.1.md §8); nothing is charged.
MBONGO_MVP_REFERENCE_USD_PER_HOUR=0.50
# Alert thresholds (runbook §6): llama-server working set, free disk.
MBONGO_MVP_LLAMA_MEMORY_ALERT_MIB=7168
MBONGO_MVP_DISK_ALERT_GIB=5
