# Versioned CI overrides, layered on top of .env.base.
#
# Selected with DEVNET_ENV=ci (see scripts/devnet/docker-devnet.sh).
# Never put secrets here: this file is public, and the devnet needs none.
#
# Wiring this into GitHub Actions is deliberately NOT part of this change;
# it belongs to the CI integration work that follows.

# Shared CI runners are slower and noisier than a developer machine: give
# readiness and convergence more room before declaring failure. The bounds
# stay finite, so a genuinely broken devnet still fails instead of hanging.
MBONGO_READY_TIMEOUT_SECS=240
MBONGO_CONVERGENCE_TIMEOUT_SECS=240

# Nothing on a CI runner reads the published port, and not publishing it
# removes a whole class of port-collision failures between concurrent jobs.
MBONGO_HOST_RPC_PORT=0

# Quieter container logs; the probe already reports per-endpoint state on
# failure, and job logs are the artifact people read.
RUST_LOG=warn
